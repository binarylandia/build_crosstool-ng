#!/usr/bin/env bash

set -euxo pipefail

export NAME="gcc"
export BUILD_DIR=".build"
export INSTALL_DIR="/opt/${NAME}"
export OUT_DIR=".out"

export NICE="nice -19 ionice -c2 -n5"
export jobs="${jobs:=$(($(nproc --all) + 2))}"
export build_time="$(date -u '+%Y-%m-%d_%H-%M-%S')"

# Configs to build, all by default. Select some with, for example:
#   ./build 'CONFIGS="configs/14.2.0_*.config" ./scripts/main'
export CONFIGS="${CONFIGS:-configs/*.config}"

# The binutils that replaces the binutils of the aarch64 glibc toolchains after
# the crosstool-ng build. crosstool-ng allows only binutils older than 2.30 with
# glibc older than 2.26 on aarch64, because newer binutils fail to compile that
# glibc (config/libc/glibc.in). The old assembler cannot assemble SVE, SVE2, and
# armv8.3+ code, so these toolchains keep the glibc that the old binutils built
# and get this binutils for everything compiled with them. The version equals
# the newest binutils that the pinned crosstool-ng offers, which the other
# toolchains use.
export BINUTILS_REPLACEMENT_VERSION="2.43.1"
export BINUTILS_REPLACEMENT_SHA256="13f74202a3c4c51118b797a39ea4200d3f6cfbe224da6d1d95bb938480132dfd"

function abspath() {
  readlink -m "$1"
}
export -f abspath

function log() {
  tee -a "${1}" | stdbuf -oL grep --color=always -iE "error|fail|cannot|can't|unable|"
}
export -f log

function package_xz() {
  local input_dir="${1}"
  local output_basename="${2}"
  mkdir -p "$(dirname "${output_basename}")"
  ${NICE} bash -c "find '${input_dir}' -printf '%P\\n' | tar --posix -cf - -C '${input_dir}' --files-from=- | xz -T $(nproc) -5 > '${output_basename}.tar.xz'"
}
export -f package_xz

function package_gz() {
  local input_dir="${1}"
  local output_basename="${2}"
  mkdir -p "$(dirname "${output_basename}")"
  ${NICE} bash -c "find '${input_dir}' -printf '%P\\n' | tar --posix -cf - -C '${input_dir}' --files-from=- | pigz -p $(nproc) -7 > '${output_basename}.tar.gz'"
}
export -f package_gz

function package_zst() {
  local input_dir="${1}"
  local output_basename="${2}"
  mkdir -p "$(dirname "${output_basename}")"
  ${NICE} bash -c "find '${input_dir}' -printf '%P\\n' | tar --posix -cf - -C '${input_dir}' --files-from=- | zstdmt -T$(nproc) -7 > '${output_basename}.tar.zst'"
}
export -f package_zst

function package_all() {
  local input_dir="${1}"
  local output_basename="${2}"

  parallel ::: \
    "package_xz '${input_dir}' '${output_basename}'" \
    "package_gz '${input_dir}' '${output_basename}'" \
    "package_zst '${input_dir}' '${output_basename}'"
}
export -f package_all

function replace() {
  local key="$1"
  local value="$2"
  local file="$3"
  sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$file"
  grep -q "^${key}=\"${value}\"" "$file" || { echo "Error: Failed to set ${key} to ${value} in ${file}"; exit 1; }
}
export -f replace

# Succeed when version $1 is equal to or newer than version $2.
function version_at_least() {
  [[ "$(printf '%s\n%s\n' "${2}" "${1}" | sort -V | head -1)" == "${2}" ]]
}
export -f version_at_least

# Build the replacement binutils for a target and install it over the binutils
# of the toolchain.
function replace_binutils() {
  set -euxo pipefail

  local arch="${1}"
  local install_dir="${2}"
  local work_dir="${3}/binutils-${BINUTILS_REPLACEMENT_VERSION}"
  local archive="${work_dir}.tar.xz"

  rm -rf "${work_dir}"
  mkdir -p "${work_dir}/src" "${work_dir}/build"
  curl -fsSLo "${archive}" --retry 3 "https://ftpmirror.gnu.org/binutils/binutils-${BINUTILS_REPLACEMENT_VERSION}.tar.xz"
  printf '%s  %s\n' "${BINUTILS_REPLACEMENT_SHA256}" "${archive}" | sha256sum -c -
  tar -C "${work_dir}/src" --strip-components=1 -xJf "${archive}"

  pushd "${work_dir}/build" >/dev/null
    ../src/configure \
      --target="${arch}" \
      --prefix="${install_dir}" \
      --with-sysroot="${install_dir}/${arch}/sysroot" \
      --disable-nls \
      --disable-werror \
      --disable-multilib \
      --disable-gdb \
      --disable-gdbserver \
      --disable-gprofng \
      --disable-sim \
      --enable-deterministic-archives
    ${NICE} make -j"${jobs}"
    ${NICE} make install
  popd >/dev/null
}
export -f replace_binutils

# Fail when the binutils of a toolchain is not the expected version, when the
# compiler driver runs another assembler, when an aarch64 toolchain cannot
# assemble SVE and SVE2 code, or when a glibc toolchain links programs that need
# a newer glibc than the one it was built with.
function check_toolchain() {
  set -euxo pipefail

  local arch="${1}"
  local install_dir="${2}"
  local config="${3}"
  local binutils_version="${4}"
  local check_dir="${5}/check"
  local bin="${install_dir}/bin/${arch}"

  rm -rf "${check_dir}"
  mkdir -p "${check_dir}"

  local tool
  for tool in "${bin}-as" "${bin}-ld" "$("${bin}-gcc" -print-prog-name=as)"; do
    if ! "${tool}" --version | head -1 | grep -qE " ${binutils_version//./\\.}\$"; then
      printf 'ERROR: %s is not binutils %s: %s\n' "${tool}" "${binutils_version}" "$("${tool}" --version | head -1)" >&2
      return 1
    fi
  done

  if [[ "${arch}" == aarch64* ]] && version_at_least "${binutils_version}" "2.38"; then
    printf 'ptrue p0.d\n' >"${check_dir}/sve.s"
    "${bin}-gcc" -march=armv8.2-a+sve -c "${check_dir}/sve.s" -o "${check_dir}/sve.o"
    printf 'addp z0.s, p0/m, z0.s, z1.s\n' >"${check_dir}/sve2.s"
    "${bin}-gcc" -march=armv8.2-a+sve2 -c "${check_dir}/sve2.s" -o "${check_dir}/sve2.o"
  fi

  local glibc_version
  glibc_version="$(sed -n 's/^CT_GLIBC_VERSION="\(.*\)"$/\1/p' "${config}")"
  if [[ -n "${glibc_version}" ]]; then
    cat >"${check_dir}/glibc.c" <<'EOF'
#include <pthread.h>
#include <stdio.h>

static void *run(void *arg) {
  puts((const char *)arg);
  return NULL;
}

int main(void) {
  pthread_t thread;
  pthread_create(&thread, NULL, run, "glibc");
  pthread_join(thread, NULL);
  printf("%d\n", 1);
  return 0;
}
EOF
    "${bin}-gcc" -O2 -pthread "${check_dir}/glibc.c" -o "${check_dir}/glibc"
    local newest
    newest="$("${bin}-objdump" -T "${check_dir}/glibc" | grep -oE 'GLIBC_[0-9]+(\.[0-9]+)+' | sed 's/^GLIBC_//' | sort -V | tail -1)"
    if ! version_at_least "${glibc_version}" "${newest}"; then
      printf 'ERROR: programs linked by the %s toolchain need glibc %s, newer than its glibc %s\n' "${arch}" "${newest}" "${glibc_version}" >&2
      return 1
    fi
  fi
}
export -f check_toolchain

export THIS_DIR="$(abspath "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)")"
export ROOT_DIR="$(abspath "${THIS_DIR}/..")"

function build_and_package() {
  set -euxo pipefail

  local conf_filepath="${1}"
  local filename=$(basename "$1")
  local gcc_version="${filename%%_*}"
  local arch="${filename#*_}"
  local arch="${arch%.config}"

  echo "Building gcc $gcc_version for $arch (based on $conf_filepath)"

  build_dir="$(abspath ${BUILD_DIR})/${gcc_version}-${arch}"
  outdir="$(abspath "${OUT_DIR}")/"
  install_dir="$(abspath "${INSTALL_DIR}")/${gcc_version}-${arch}"
  mkdir -p "${build_dir}" "${outdir}" "${install_dir}"

  pushd "$build_dir" >/dev/null
    src_dir="${NAME}-${arch}"

    mkdir -p "${src_dir}"
    pushd "${src_dir}" >/dev/null
      cp "${ROOT_DIR}/${conf_filepath}" ".config"

      replace "CT_PREFIX_DIR" "${install_dir}" ".config"

      ${NICE} ct-ng build.${jobs}

      if [[ "${arch}" =~ (mingw|windows) ]]; then
        # HACK: symlink missing libgcc_eh.a, because cargo insists it's needed. However, mingw toolchain does not have it.
        # https://github.com/r-windows/rtools-packages/issues/185
        # https://github.com/skeeto/w64devkit/issues/52
        pushd "${install_dir}/lib/gcc/x86_64-w64-mingw32/${gcc_version}" >/dev/null
          ln -s "libgcc.a" "libgcc_eh.a"
        popd >/dev/null

        # HACK: sysroot in MinGW GCC is nested under additional `mingw/` path segment, copy it upstairs to avoid having to
        # set different sysroot variables for Linux and Windows
        cp -r "${install_dir}/x86_64-w64-mingw32/sysroot/mingw/"* "${install_dir}/x86_64-w64-mingw32/sysroot"/
      fi

      if [[ "${arch}" == "aarch64-unknown-linux-gnu" ]]; then
        replace_binutils "${arch}" "${install_dir}" "${build_dir}"
        binutils_version="${BINUTILS_REPLACEMENT_VERSION}"
      else
        binutils_version="$(sed -n 's/^CT_BINUTILS_VERSION="\(.*\)"$/\1/p' ".config")"
      fi
      check_toolchain "${arch}" "${install_dir}" ".config" "${binutils_version}" "${build_dir}"

      package_all "${install_dir}" "${outdir}/${NAME}-${gcc_version}-${arch}-${build_time}"
    popd >/dev/null
  popd >/dev/null
}

export -f build_and_package
# shellcheck disable=SC2086 # CONFIGS holds a glob
parallel -j4 --halt soon,fail=1 --line-buffer --tag build_and_package ::: ${CONFIGS}

