#!/usr/bin/env bash

set -euxo pipefail

export NAME="gcc"
export BUILD_DIR=".build"
export INSTALL_DIR="/opt/${NAME}"
export OUT_DIR=".out"

export NICE="nice -19 ionice -c2 -n5"
export jobs="${jobs:=$(($(nproc --all) + 2))}"
export build_time="${BUILD_TIME:-$(date -u '+%Y-%m-%d_%H-%M-%S')}"

# Configs to build, all by default. Select some with, for example:
#   ./build 'CONFIGS="configs/14.4.0_*.config" ./scripts/main'
export CONFIGS="${CONFIGS:-configs/*.config}"

function abspath() {
  readlink -m "$1"
}
export -f abspath

function log() {
  tee -a "${1}" | stdbuf -oL grep --color=always -iE "error|fail|cannot|can't|unable|"
}
export -f log

# Write the files of a directory as a tar stream to stdout. The entries are
# sorted, owned by root, and carry the time SOURCE_DATE_EPOCH, so the same files
# always give the same archive. Each path is listed once; tar does not recurse.
function tar_dir() {
  local input_dir="${1}"
  find "${input_dir}" -mindepth 1 -printf '%P\n' | LC_ALL=C sort |
    tar --posix --no-recursion --mtime="@${SOURCE_DATE_EPOCH}" --owner=0 --group=0 --numeric-owner \
      --pax-option=exthdr.name=%d/PaxHeaders/%f,delete=atime,delete=ctime \
      -cf - -C "${input_dir}" --files-from=-
}
export -f tar_dir

# The compressors give the same output for the same input with any number of
# threads: xz in its multi-threaded mode, pigz without the file name and time,
# and zstd always.
function package_xz() {
  local input_dir="${1}"
  local output_basename="${2}"
  mkdir -p "$(dirname "${output_basename}")"
  ${NICE} bash -c "tar_dir '${input_dir}' | xz -T $(( $(nproc) > 1 ? $(nproc) : 2 )) -5 > '${output_basename}.tar.xz'"
}
export -f package_xz

function package_gz() {
  local input_dir="${1}"
  local output_basename="${2}"
  mkdir -p "$(dirname "${output_basename}")"
  ${NICE} bash -c "tar_dir '${input_dir}' | pigz -n -p $(nproc) -7 > '${output_basename}.tar.gz'"
}
export -f package_gz

function package_zst() {
  local input_dir="${1}"
  local output_basename="${2}"
  mkdir -p "$(dirname "${output_basename}")"
  ${NICE} bash -c "tar_dir '${input_dir}' | zstdmt -T$(nproc) -7 > '${output_basename}.tar.zst'"
}
export -f package_zst

function package_all() {
  local input_dir="${1}"
  local output_basename="${2}"

  parallel ::: \
    "package_xz '${input_dir}' '${output_basename}'" \
    "package_gz '${input_dir}' '${output_basename}'" \
    "package_zst '${input_dir}' '${output_basename}'"
}
export -f package_all

function replace() {
  local key="$1"
  local value="$2"
  local file="$3"
  sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$file"
  grep -q "^${key}=\"${value}\"" "$file" || { echo "Error: Failed to set ${key} to ${value} in ${file}"; exit 1; }
}
export -f replace

# Succeed when version $1 is equal to or newer than version $2.
function version_at_least() {
  [[ "$(printf '%s\n%s\n' "${2}" "${1}" | sort -V | head -1)" == "${2}" ]]
}
export -f version_at_least

# Fail when the binutils of a toolchain is not the expected version, when the
# compiler driver runs another assembler, when an aarch64 toolchain cannot
# assemble SVE and SVE2 code, or when a glibc toolchain links programs that need
# a newer glibc than the one it was built with.
function check_toolchain() {
  set -euxo pipefail

  local arch="${1}"
  local install_dir="${2}"
  local config="${3}"
  local binutils_version="${4}"
  local check_dir="${5}/check"
  local bin="${install_dir}/bin/${arch}"

  rm -rf "${check_dir}"
  mkdir -p "${check_dir}"

  local tool
  for tool in "${bin}-as" "${bin}-ld" "$("${bin}-gcc" -print-prog-name=as)"; do
    # A release reports its version with the release date, such as 2.47.20260726.
    if ! "${tool}" --version | head -1 | grep -qE " ${binutils_version//./\\.}(\.[0-9]{8})?\$"; then
      printf 'ERROR: %s is not binutils %s: %s\n' "${tool}" "${binutils_version}" "$("${tool}" --version | head -1)" >&2
      return 1
    fi
  done

  # A static toolchain runs on any host; a dynamically linked tool would need
  # the glibc of the build container.
  if grep -q '^CT_STATIC_TOOLCHAIN=y$' "${config}"; then
    for tool in "${install_dir}/bin/"* "${install_dir}/${arch}/bin/"*; do
      # readelf rejects the shell scripts among the tools, such as the ldd wrapper.
      if [[ -f "${tool}" && -x "${tool}" ]] && readelf -l "${tool}" 2>/dev/null | grep -q 'program interpreter'; then
        printf 'ERROR: %s is dynamically linked in a static toolchain\n' "${tool}" >&2
        return 1
      fi
    done
  fi

  # The runtime libraries go into position-independent executables and shared
  # libraries, which only PIC archives allow (GCC --with-pic). Linking a Fortran
  # program that pulls libgfortran and libquadmath both ways checks this.
  if [[ "${arch}" == *-linux-* ]]; then
    printf 'subroutine f(x)\n  real(8) :: x\n  character(8) :: s\n  write (s, "(f8.3)") x\n  print *, trim(s) // "!"\nend\n' >"${check_dir}/pic.f90"
    "${bin}-gfortran" -c -fPIC "${check_dir}/pic.f90" -o "${check_dir}/pic.o"
    local fortran_runtime=()
    local runtime_archive
    for runtime_archive in libgfortran.a libquadmath.a; do
      runtime_archive="$("${bin}-gfortran" -print-file-name="${runtime_archive}")"
      if [[ "${runtime_archive}" == /* ]]; then
        fortran_runtime+=("${runtime_archive}")
      fi
    done
    printf 'void f_(double *);\nint main(void) { double x = 1.5; f_(&x); return 0; }\n' >"${check_dir}/pic-main.c"
    "${bin}-gcc" -fPIE -pie "${check_dir}/pic-main.c" "${check_dir}/pic.o" "${fortran_runtime[@]}" -lm -o "${check_dir}/pic-exe"
    "${bin}-gcc" -fPIC -shared "${check_dir}/pic.o" "${fortran_runtime[@]}" -lm -o "${check_dir}/pic.so"
  fi

  # Rust's windows-gnu targets and the MinGW runtime objects that rustc bundles
  # are built for msvcrt; a toolchain whose default runtime is the UCRT makes
  # mixed binaries that crash at startup. In a UCRT toolchain, libmsvcrt.a is a
  # copy of libucrt.a.
  if [[ "${arch}" == *-mingw32 ]]; then
    local libdir
    libdir="$(dirname "$("${bin}-gcc" -print-file-name=libmsvcrt.a)")"
    if cmp -s "${libdir}/libmsvcrt.a" "${libdir}/libucrt.a"; then
      printf 'ERROR: the default C runtime of the %s toolchain is the UCRT, not msvcrt\n' "${arch}" >&2
      return 1
    fi
  fi

  if [[ "${arch}" == aarch64* ]] && version_at_least "${binutils_version}" "2.38"; then
    printf 'ptrue p0.d\n' >"${check_dir}/sve.s"
    "${bin}-gcc" -march=armv8.2-a+sve -c "${check_dir}/sve.s" -o "${check_dir}/sve.o"
    printf 'addp z0.s, p0/m, z0.s, z1.s\n' >"${check_dir}/sve2.s"
    "${bin}-gcc" -march=armv8.2-a+sve2 -c "${check_dir}/sve2.s" -o "${check_dir}/sve2.o"
  fi

  local glibc_version
  glibc_version="$(sed -n 's/^CT_GLIBC_VERSION="\(.*\)"$/\1/p' "${config}")"
  if [[ -n "${glibc_version}" ]]; then
    cat >"${check_dir}/glibc.c" <<'EOF'
#include <pthread.h>
#include <stdio.h>

static void *run(void *arg) {
  puts((const char *)arg);
  return NULL;
}

int main(void) {
  pthread_t thread;
  pthread_create(&thread, NULL, run, "glibc");
  pthread_join(thread, NULL);
  printf("%d\n", 1);
  return 0;
}
EOF
    "${bin}-gcc" -O2 -pthread "${check_dir}/glibc.c" -o "${check_dir}/glibc"
    local newest
    newest="$("${bin}-objdump" -T "${check_dir}/glibc" | grep -oE 'GLIBC_[0-9]+(\.[0-9]+)+' | sed 's/^GLIBC_//' | sort -V | tail -1)"
    if ! version_at_least "${glibc_version}" "${newest}"; then
      printf 'ERROR: programs linked by the %s toolchain need glibc %s, newer than its glibc %s\n' "${arch}" "${newest}" "${glibc_version}" >&2
      return 1
    fi
  fi
}
export -f check_toolchain

# Write <archive basename>.json with the facts of a toolchain that scripts/release
# puts into the manifest of a release.
function write_metadata() {
  local output_basename="${1}"
  local arch="${2}"
  local gcc_version="${3}"
  local binutils_version="${4}"
  local config="${5}"
  local libc
  libc="$(sed -n 's/^CT_LIBC="\(.*\)"$/\1/p' "${config}")"
  local libc_version
  libc_version="$(sed -n "s/^CT_$(tr '[:lower:]-' '[:upper:]_' <<<"${libc}")_VERSION=\"\(.*\)\"$/\1/p" "${config}")"
  local name="${output_basename##*/}"
  jq -n \
    --arg name "${name}" \
    --arg target "${arch}" \
    --arg gcc "${gcc_version}" \
    --arg binutils "${binutils_version}" \
    --arg libc "${libc}" \
    --arg libc_version "${libc_version}" \
    --arg crosstool_ng "${CT_NG_COMMIT:?}" \
    --arg base_image "${DOCKER_BASE_IMAGE:?}" \
    --arg build_commit "${BUILD_COMMIT:?}" \
    --argjson build_dirty "${BUILD_DIRTY:?}" \
    --arg build_time "${build_time}" \
    '{name: $name, target: $target, gcc: $gcc, binutils: $binutils, libc: $libc, libc_version: $libc_version,
      crosstool_ng: $crosstool_ng, base_image: $base_image, build_commit: $build_commit, build_dirty: $build_dirty,
      build_time: $build_time, files: [($name + ".tar.xz"), ($name + ".tar.gz"), ($name + ".tar.zst")]}' \
    >"${output_basename}.json"
}
export -f write_metadata

export THIS_DIR="$(abspath "$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)")"
export ROOT_DIR="$(abspath "${THIS_DIR}/..")"

function build_and_package() {
  set -euxo pipefail

  local conf_filepath="${1}"
  local filename=$(basename "$1")
  local gcc_version="${filename%%_*}"
  local arch="${filename#*_}"
  local arch="${arch%.config}"

  echo "Building gcc $gcc_version for $arch (based on $conf_filepath)"

  build_dir="$(abspath ${BUILD_DIR})/${gcc_version}-${arch}"
  outdir="$(abspath "${OUT_DIR}")/${build_time}"
  install_dir="$(abspath "${INSTALL_DIR}")/${gcc_version}-${arch}"
  mkdir -p "${build_dir}" "${outdir}" "${install_dir}"

  pushd "$build_dir" >/dev/null
    src_dir="${NAME}-${arch}"

    mkdir -p "${src_dir}"
    pushd "${src_dir}" >/dev/null
      cp "${ROOT_DIR}/${conf_filepath}" ".config"

      replace "CT_PREFIX_DIR" "${install_dir}" ".config"

      ${NICE} ct-ng build.${jobs}

      if [[ "${arch}" =~ (mingw|windows) ]]; then
        # HACK: symlink missing libgcc_eh.a, because cargo insists it's needed. However, mingw toolchain does not have it.
        # https://github.com/r-windows/rtools-packages/issues/185
        # https://github.com/skeeto/w64devkit/issues/52
        pushd "${install_dir}/lib/gcc/x86_64-w64-mingw32/${gcc_version}" >/dev/null
          ln -s "libgcc.a" "libgcc_eh.a"
        popd >/dev/null

        # HACK: sysroot in MinGW GCC is nested under additional `mingw/` path segment, copy it upstairs to avoid having to
        # set different sysroot variables for Linux and Windows
        cp -r "${install_dir}/x86_64-w64-mingw32/sysroot/mingw/"* "${install_dir}/x86_64-w64-mingw32/sysroot"/
      fi

      binutils_version="$(sed -n 's/^CT_BINUTILS_VERSION="\(.*\)"$/\1/p' ".config")"
      check_toolchain "${arch}" "${install_dir}" ".config" "${binutils_version}" "${build_dir}"

      local name="${NAME}-${gcc_version}-${arch}-${build_time}"
      package_all "${install_dir}" "${outdir}/${name}"
      write_metadata "${outdir}/${name}" "${arch}" "${gcc_version}" "${binutils_version}" ".config"
    popd >/dev/null
  popd >/dev/null
}

export -f build_and_package
# shellcheck disable=SC2086 # CONFIGS holds a glob
parallel -j4 --halt soon,fail=1 --line-buffer --tag build_and_package ::: ${CONFIGS}

