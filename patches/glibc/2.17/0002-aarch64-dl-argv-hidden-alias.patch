aarch64: store _dl_argv in ld.so through its hidden alias

RTLD_START writes the argument vector to _dl_argv with a PC-relative
ADRP/STR pair. _dl_argv is an exported symbol, and binutils 2.30 and later
reject a PC-relative relocation against a symbol that may bind externally
when they link ld.so as a shared object. glibc 2.27 writes the hidden alias
__GI__dl_argv instead; glibc 2.17 names its hidden alias _dl_argv_internal
(INTDEF in elf/rtld.c).

--- a/ports/sysdeps/aarch64/dl-machine.h
+++ b/ports/sysdeps/aarch64/dl-machine.h
@@ -156,8 +156,8 @@
 	cmp	x0, #0						\n\
 	bne	1b						\n\
 	// Update _dl_argv					\n\
-	adrp	x3, _dl_argv					\n\
-	str	x2, [x3, #:lo12:_dl_argv]			\n\
+	adrp	x3, _dl_argv_internal				\n\
+	str	x2, [x3, #:lo12:_dl_argv_internal]		\n\
 .L_done_stack_adjust:						\n\
 	// compute envp						\n\
 	add	x3, x2, x1, lsl #3				\n\
